# ----------------------------------------------------------------------
# Estilos Gestor — variáveis de ambiente
# Copie para ".env.local" (desenvolvimento) e configure também na Vercel.
# Sem as duas variáveis do Supabase, o app roda em MODO DEMONSTRAÇÃO
# (dados salvos só no navegador, claramente identificado na tela).
# ----------------------------------------------------------------------

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E-mail de contato exibido no rodapé (pode ser alterado depois pelo painel admin)
NEXT_PUBLIC_SUPPORT_EMAIL=

# Endereço público do site (usado em links e metadados), ex.: https://estilosgestor.com.br
NEXT_PUBLIC_SITE_URL=

# ---------------- Notificações push ----------------
# Gere todas de uma vez com:  npm run push:chaves
# Pública (vai para o navegador para inscrever o aparelho):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SOMENTE SERVIDOR — nunca coloque NEXT_PUBLIC_ nestas:
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
PUSH_DISPATCH_SECRET=
# Supabase > Project Settings > API > service_role (secreta; usada só nas rotas /api/push)
SUPABASE_SERVICE_ROLE_KEY=
